{
  "name": "tutoring-tools",
  "version": "0.1.0",
  "private": true,
  "description": "A curated maths question bank: browse, filter and practise, with generated questions that give fresh numbers every time.",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.js",
    "reseed": "node --no-warnings=ExperimentalWarning scripts/seed.js --force",
    "snapshot": "node --no-warnings=ExperimentalWarning scripts/snapshot.js",
    "check:questions": "node --no-warnings=ExperimentalWarning scripts/check-questions.js",
    "build:seed": "node --no-warnings=ExperimentalWarning scripts/build-seed.js",
    "restore": "node --no-warnings=ExperimentalWarning scripts/restore.js",
    "test": "node --no-warnings=ExperimentalWarning --test",
    "audit": "node --no-warnings=ExperimentalWarning scripts/audit-bank.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "katex": "^0.16.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  }
}
