    {
      "external_key": "q-geometry-angles-regular-polygons",
      "topic": "Angles",
      "subtopic": "Regular polygons",
      "difficulty": 3,
      "kind": "template",
      "statement": "Each interior angle of a regular polygon measures ${{fmt(180 - 360/n, 1)}}^\\circ$. How many sides does it have?",
      "answer": "${{n}}$",
      "solution": "Each exterior angle is $180 - {{fmt(180 - 360/n, 1)}} = {{fmt(360/n, 1)}}$ degrees. Exterior angles of any polygon sum to $360^\\circ$, so there are $360 \\div {{fmt(360/n, 1)}} = {{n}}$ of them.",
      "tags": [
        "angles",
        "polygons"
      ],
