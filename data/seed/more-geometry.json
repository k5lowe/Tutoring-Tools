    {
      "external_key": "q-geometry-right-triangles-pythagorean-theorem",
      "topic": "Right Triangles",
      "subtopic": "Pythagorean theorem",
      "difficulty": 1,
      "kind": "template",
      "statement": "A right triangle has legs of length ${{k*3}}$ and ${{k*4}}$. Find the hypotenuse.",
      "answer": "${{k*5}}$",
      "solution": "$({{k*3}})^2 + ({{k*4}})^2 = {{k*k*9}} + {{k*k*16}} = {{k*k*25}}$, and $\\sqrt{ {{k*k*25}} } = {{k*5}}$. This is a $3$–$4$–$5$ triangle scaled by ${{k}}$.",
      "tags": [
        "pythagorean",
        "right-triangles",
        "drill"
      ],
      "source_book": "",
      "source_chapter": "",
      "source_section": "",
