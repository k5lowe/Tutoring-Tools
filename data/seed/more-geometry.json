    {
      "external_key": "q-geometry-triangles-exterior-angle-theorem",
      "topic": "Triangles",
      "subtopic": "Exterior angle theorem",
      "difficulty": 2,
      "kind": "template",
      "statement": "In a triangle, two interior angles measure ${{a}}^\\circ$ and ${{b}}^\\circ$. Find the exterior angle at the third vertex.",
      "answer": "${{a + b}}^\\circ$",
      "solution": "An exterior angle equals the sum of the two non-adjacent interior angles: ${{a}} + {{b}} = {{a + b}}$ degrees. Equivalently, the third interior angle is ${{180 - a - b}}^\\circ$, and $180 - {{180 - a - b}} = {{a + b}}$.",
      "tags": [
        "triangles",
        "angles"
      ],
