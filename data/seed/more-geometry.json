    {
      "external_key": "q-geometry-triangles-triangle-inequality",
      "topic": "Triangles",
      "subtopic": "Triangle inequality",
      "difficulty": 2,
      "kind": "template",
      "statement": "Two sides of a triangle measure ${{a}}$ and ${{b}}$. Between what two values must the third side lie?",
      "answer": "Greater than ${{abs(a - b)}}$ and less than ${{a + b}}$.",
      "solution": "Any side must be shorter than the sum of the other two and longer than their difference: ${{a}} - {{b}}$ in absolute value is ${{abs(a - b)}}$, and ${{a}} + {{b}} = {{a + b}}$.",
      "tags": [
        "triangles"
      ],
      "source_book": "",
      "source_chapter": "",
