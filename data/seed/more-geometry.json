      "external_key": "q-geometry-angles-complementary-and-supplementary",
      "topic": "Angles",
      "subtopic": "Complementary and supplementary",
      "difficulty": 1,
      "kind": "template",
      "statement": "Two angles are supplementary. One measures ${{a}}^\\circ$. What is the other?",
      "answer": "${{180 - a}}^\\circ$",
      "solution": "Supplementary angles add to $180^\\circ$, so the other is $180 - {{a}} = {{180 - a}}$ degrees.",
