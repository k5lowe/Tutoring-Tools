    {
      "external_key": "q-precalculus-trigonometry-pythagorean-identity",
      "topic": "Trigonometry",
      "subtopic": "Pythagorean identity",
      "difficulty": 3,
      "kind": "template",
      "statement": "Given $\\sin\\theta = {{frac(a, c)}}$ with $\\theta$ in the first quadrant, find $\\cos\\theta$ exactly.",
      "answer": "$\\cos\\theta = {{frac(b, c)}}$",
      "solution": "$\\cos^2\\theta = 1 - \\sin^2\\theta = 1 - \\dfrac{ {{a*a}} }{ {{c*c}} } = \\dfrac{ {{b*b}} }{ {{c*c}} }$. In the first quadrant cosine is positive, so $\\cos\\theta = {{frac(b, c)}}$.",
      "tags": [
        "trigonometry"
      ],
      "source_book": "",
      "source_chapter": "",
      "source_section": "",
      "source_number": "",
      "params": {
        "vars": {
          "t": {
            "type": "choice",
            "values": [
              1,
              2,
              3,
              4
            ]
          },
          "a": {
            "type": "expr",
            "expr": "ifelse(t == 1, 3, ifelse(t == 2, 5, ifelse(t == 3, 8, 20)))"
          },
          "b": {
            "type": "expr",
            "expr": "ifelse(t == 1, 4, ifelse(t == 2, 12, ifelse(t == 3, 15, 21)))"
          },
          "c": {
            "type": "expr",
            "expr": "ifelse(t == 1, 5, ifelse(t == 2, 13, ifelse(t == 3, 17, 29)))"
          }
        }
      }
